{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/lookup", "destination": "/api/lookup" },
    { "source": "/api/meta", "destination": "/api/meta" },
    { "source": "/api/leaderboard", "destination": "/api/leaderboard" },
    { "source": "/api/generate-report", "destination": "/api/generate-report" },
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/teacher/auth", "destination": "/api/teacher/auth" },
    { "source": "/api/teacher/marks", "destination": "/api/teacher/marks" },
    { "source": "/api/teacher/pe-analysis", "destination": "/api/teacher/pe-analysis" },
    { "source": "/api/teacher/save", "destination": "/api/teacher/save" },
    { "source": "/api/teacher/change-password", "destination": "/api/teacher/change-password" },
    { "source": "/api/teacher/forgot-password", "destination": "/api/teacher/forgot-password" },
    { "source": "/teacher", "destination": "/teacher/index.html" },
    { "source": "/teacher/", "destination": "/teacher/index.html" },
    { "source": "/generator", "destination": "/generator/index.html" },
    { "source": "/generator/", "destination": "/generator/index.html" },
    { "source": "/teacher-credentials", "destination": "/teacher-credentials.html" },
    { "source": "/((?!api/).*)", "destination": "/$1" }
  ],
  "functions": {
    "api/generate-report.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
